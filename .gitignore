# from Gemini 2026-04-09 - it insists on referencing my 2 fields!

# --- Python Archeology (The "Internal" Records) ---
__pycache__/
*.py[cod]
*$py.class

# --- The "Field Office" (Environments) ---
# Your virtual environments—always keep these local
venv/
.venv/
env/
bin/
lib/

# --- The "Clinical Records" (Sensitive Data) ---
# Logs and local databases
*.log
*.sqlite3
*.db
# oxalate.db is a static, committed reference database (see README), not
# user data — the one deliberate exception to the *.db rule above.
!oxalate.db
# Confidential credentials (API keys, etc.)
.env

# --- AI tooling / scratch files ---
claude_prompt.txt
claude_response.txt
numa_gen_prompt.py
numa_import_claude.py
food_imports/

# --- Generated / cached output ---
user-manual.html
web/home_body.cache

# --- PyInstaller build artifacts ---
build/
dist/
dist-windows/
*.spec
# nutrimagnus.spec is hand-maintained (custom datas/hiddenimports for the
# web-app bundle) — no longer an auto-generated throwaway file.
!nutrimagnus.spec

# --- The "Large Artifacts" ---
# Exclude large data or model weights for local LLMs
data/
models/

# --- Claude Code agent worktrees (internal, never commit) ---
.claude/worktrees/